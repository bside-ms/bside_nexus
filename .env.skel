# sslmode in the URL overrides `ssl: true` from db/index.ts (e.g. ?sslmode=disable for a local Postgres)
DATABASE_URL=

# Public URL of Nexus (prod: https://intern.b-side.ms)
AUTH_URL=
AUTH_SECRET=

# Must end with a trailing slash (prod: https://login.b-side.ms/)
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_API_USER=
KEYCLOAK_API_PASS=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# production | test | development. Anything but "production" (also unset) enables the test mode.
NEXUS_ENVIRONMENT=

# MATTERMOST_AUTH_TOKEN is the token of the Nexus bot
MATTERMOST_URL=
MATTERMOST_AUTH_TOKEN=
# Test mode only.
MATTERMOST_TEST_CHANNEL_ID=
MATTERMOST_TEST_USERS=

# Support mail address shown on the dashboard and in error messages (optional, hidden if empty)
SUPPORT_EMAIL=

# DOCX -> PDF via LibreOffice (soffice must be on PATH). Enabled with true/yes/1/on.
PDF_DOCX_ENABLED=
PDF_TIMEOUT_MS=15000

# Nextcloud folder for the signed key receipts (WebDAV). Use a service account with an app password.
# NEXTCLOUD_URL without trailing path (https://cloud.b-side.ms).
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
# NEXTCLOUD_KEY_FOLDER is relative to the account's files.
NEXTCLOUD_KEY_FOLDER=
