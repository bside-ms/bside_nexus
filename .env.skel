# sslmode in the URL overrides `ssl: true` from db/index.ts (e.g. ?sslmode=disable for a local Postgres)
DATABASE_URL=

# Public URL of Nexus (prod: https://intern.b-side.ms)
AUTH_URL=
AUTH_SECRET=

# Must end with a trailing slash (prod: https://login.b-side.ms/)
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_API_USER=
KEYCLOAK_API_PASS=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

MATTERMOST_URL=
MATTERMOST_AUTH_TOKEN=

# Support mail address shown on the dashboard and in error messages (optional, hidden if empty)
SUPPORT_EMAIL=

# DOCX -> PDF via LibreOffice (soffice must be on PATH). Enabled with true/yes/1/on.
PDF_DOCX_ENABLED=
PDF_TIMEOUT_MS=15000
